# Saaras v3 detects Tamil, English, Hindi, and other supported languages.
SARVAM_STT_LANGUAGE=unknown
SARVAM_STT_MODE=transcribe

# Bulbul v3 is Tamil-first by default. Change both values at deploy time.
SARVAM_TTS_LANGUAGE=ta-IN
SARVAM_TTS_SPEAKER=kavitha
